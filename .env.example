# Base de datos Postgres. En Supabase: Project Settings → Database → Connection string.
# DATABASE_URL usa el "Transaction pooler" (puerto 6543) y agrega ?pgbouncer=true
# DIRECT_URL usa la conexión directa o el "Session pooler" (puerto 5432), para crear las tablas.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/arevalo_marketing"
DIRECT_URL="postgresql://usuario:clave@localhost:5432/arevalo_marketing"

# Supabase Storage para fotos y videos (Project Settings → API).
# La service role key es secreta: solo en el servidor, nunca en una variable NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Contraseña para entrar a la app. Cámbiala.
APP_PASSWORD="cambia-esta-clave"

# Clave secreta para cifrar los tokens de tus cuentas (mínimo 32 caracteres).
# Genera una con:  openssl rand -base64 32
APP_SECRET="pon-aqui-una-clave-larga-de-al-menos-32-caracteres"

# Dirección pública de la app (https://… en Vercel).
PUBLIC_BASE_URL="http://localhost:3000"

# Clave del publicador automático. Vercel Cron la manda sola en cada llamada a /api/cron.
CRON_SECRET="otra-clave-secreta"

# Para el canal "Sitio web": Claude redacta el artículo en español e inglés.
ANTHROPIC_API_KEY=""

# Botón "Conectar con Facebook" (Facebook + Instagram). Una app de developers.facebook.com
# con https://TU-APP/api/meta/callback como "Valid OAuth Redirect URI".
META_APP_ID=""
META_APP_SECRET=""
# Opcional: ID de una configuración de "Facebook Login for Business" (si Meta la exige en lugar de los permisos).
META_CONFIG_ID=""
# Textos con Google Gemini (aistudio.google.com/apikey). Si está, se usa en vez de Claude.
GEMINI_API_KEY=
# Fotos y videos con IA (fal.ai/dashboard/keys)
FAL_KEY=
