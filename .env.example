# Base de datos. En tu computadora usa SQLite (un archivo). En la nube usa Postgres.
DATABASE_URL="file:./dev.db"

# Contraseña para entrar a la app. Cámbiala.
APP_PASSWORD="cambia-esta-clave"

# Clave secreta para cifrar los tokens de tus cuentas (mínimo 32 caracteres).
# Genera una con:  openssl rand -base64 32
APP_SECRET="pon-aqui-una-clave-larga-de-al-menos-32-caracteres"

# Dirección pública de la app (para que Instagram/TikTok puedan bajar tus fotos y videos).
PUBLIC_BASE_URL="http://localhost:3000"

# Clave para el publicador automático de publicaciones programadas (/api/cron).
CRON_SECRET="otra-clave-secreta"
