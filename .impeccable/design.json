      "css": ".ds-voice{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 12px;background:none;font:400 13px var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);color:var(--ink,#0a0a0a);cursor:pointer;min-height:40px;border:1px solid var(--line,#e8e8e8);border-radius:8px;}.ds-voice:hover{background:none;}.ds-voice[aria-pressed=\"true\"]{background:var(--agent-tint,#e8f7f4);color:var(--agent-accent,#087f75);}.ds-voice:focus-visible{outline:2px solid var(--agent-accent,#087f75);outline-offset:4px;}.ds-voice:disabled{cursor:wait;opacity:0.55;}@media(max-width:560px){.ds-voice{padding:8px;}}"
    },
    {
      "name": "Task disclosure",
      "kind": "custom",
      "refersTo": "task-disclosure",
      "description": "A native disclosure that reveals specialist steps and wraps output.",
      "html": "<details class=\"ds-task\"><summary class=\"ds-task-summary\"><span class=\"ds-task-title\">Revisar noticias de la industria</span><span class=\"ds-task-status\">En cola</span></summary><p class=\"ds-task-output\">Los pasos y resultados aparecerán cuando avance el encargo.</p></details>",
      "css": ".ds-task{border-top:1px solid var(--line,#e8e8e8);padding:14px 0;color:var(--ink,#0a0a0a);font-family:var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);}.ds-task-summary{cursor:pointer;list-style:none;}.ds-task-summary::-webkit-details-marker{display:none;}.ds-task-summary:hover{background:transparent;}.ds-task-summary:focus-visible{outline:2px solid var(--agent-accent,#087f75);outline-offset:4px;}.ds-task-title{display:block;font-size:14px;font-weight:500;line-height:1.45;overflow-wrap:anywhere;}.ds-task-status{display:inline-block;margin-top:6px;font-size:12px;color:var(--muted,#666);}.ds-task-status[data-status=\"completed\"],.ds-task-status[data-status=\"running\"]{color:var(--agent-accent,#087f75);}.ds-task-output{font-size:13px;line-height:1.6;overflow-wrap:anywhere;white-space:pre-wrap;margin:8px 0;}@media(max-width:950px){.ds-task{padding:18px 0;}}"
    }
  ],
  "narrative": {
    "northStar": "The Clear Workspace",
    "overview": "MATYA's application puts legible work, familiar controls and clear status ahead of decoration. Figtree unifies titles, navigation and body text. White space and fine neutral rules establish hierarchy; turquoise identifies actions and the current context. The north star is a descriptive name for the implemented system, not a newly selected identity.\n\nThe incumbent application is the visual authority. Centro MATYA extends it with compact conversation, task and settings patterns. The public website and its 3D agent are separate visual surfaces; this document does not redefine them. Spanish and English use the same flexible layouts and control hierarchy.",
    "keyCharacteristics": [
      "One Figtree family with weight and size carrying hierarchy.",
      "Flat surfaces, fine rules and rounded functional containers.",
      "Turquoise action fills paired with dark text; deeper teal for links and small accents.",
      "Clear labels, visible focus and status communicated in words as well as color.",
      "Responsive controls that retain business context and readable work output."
    ],
    "rules": [
      {
        "name": "The Readable Accent Rule",
        "body": "Use dark text on the bright turquoise action fill; use the deeper link or scoped accent color for text on light surfaces.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Keep Figtree for interface text; establish hierarchy through the existing size, weight and spacing roles.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use the existing border and surface roles for resting containers; reserve stronger depth for overlays and explicit interactive state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared CSS variables so new components inherit Claro, Noche and Vidrio.",
      "Do keep Figtree and the existing compact control hierarchy across new app screens.",
      "Do pair bright action fills with dark text and use deeper teal for readable links.",
      "Do retain explicit labels, visible keyboard focus and nearby save/error feedback.",
      "Do let long content wrap and collapse field groups at the observed mobile breakpoints.",
      "Do connect task status and motion to actual reported state."
    ],
    "donts": [
      "Don't replace the incumbent application identity with the public website's visual treatment.",
      "Don't use bright turquoise as small body text on white.",
      "Don't add ambient shadows to ordinary Claro or Noche cards.",
      "Don't make status depend on color, an icon or animation alone.",
      "Don't make every task or source row a new outer card when the implemented list pattern applies.",
      "Don't present a simulated result, empty history or pending action as completed work."
    ]
  }
}
