  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing shared pill control; text and state follow the active app theme.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Guardar configuración</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 18px;border-radius:var(--pill,980px);border:1px solid transparent;font:500 14px var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);letter-spacing:-0.01em;cursor:pointer;text-decoration:none;transition:background 0.15s,border-color 0.15s,color 0.15s;background:var(--primary,#14c4b4);border-color:var(--primary,#14c4b4);color:var(--primary-ink,#0a0a0a);font-weight:600;}.ds-button-primary:hover:not(:disabled){background:var(--primary-hover,#0fb1a2);border-color:var(--primary-hover,#0fb1a2);}.ds-button-primary:focus-visible{outline:2px solid var(--focus,#0b6e66);outline-offset:2px;}.ds-button-primary:disabled{opacity:0.5;cursor:not-allowed;}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Existing shared pill control; text and state follow the active app theme.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Actualizar</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 18px;border-radius:var(--pill,980px);border:1px solid transparent;font:500 14px var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);letter-spacing:-0.01em;cursor:pointer;text-decoration:none;transition:background 0.15s,border-color 0.15s,color 0.15s;background:var(--btn-bg,#f2f2f2);color:var(--ink,#0a0a0a);}.ds-button-secondary:hover:not(:disabled){background:var(--btn-hover,#e8e8e8);}.ds-button-secondary:focus-visible{outline:2px solid var(--focus,#0b6e66);outline-offset:2px;}.ds-button-secondary:disabled{opacity:0.5;cursor:not-allowed;}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Existing shared pill control; text and state follow the active app theme.",
      "html": "<button type=\"button\" class=\"ds-button-outline\">Agregar fuente</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 18px;border-radius:var(--pill,980px);border:1px solid transparent;font:500 14px var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);letter-spacing:-0.01em;cursor:pointer;text-decoration:none;transition:background 0.15s,border-color 0.15s,color 0.15s;background:transparent;border-color:var(--brand,#0b6e66);color:var(--link,#0b6e66);}.ds-button-outline:hover:not(:disabled){background:var(--brand-soft,#e3faf7);}.ds-button-outline:focus-visible{outline:2px solid var(--focus,#0b6e66);outline-offset:2px;}.ds-button-outline:disabled{opacity:0.5;cursor:not-allowed;}"
    },
    {
      "name": "Labeled field",
      "kind": "input",
      "refersTo": "field",
      "description": "Shared field with the incumbent focus ring and visible label.",
      "html": "<label class=\"ds-field-label\" for=\"ds-objective\">Objetivo del negocio</label><input class=\"ds-field\" id=\"ds-objective\" placeholder=\"Qué quieres lograr\" type=\"text\">",
      "css": ".ds-field-label{display:block;margin-bottom:8px;color:var(--ink,#0a0a0a);font:600 14px var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);letter-spacing:-0.01em;}.ds-field{display:block;width:100%;border:1px solid var(--line-strong,#d4d4d4);border-radius:12px;padding:11px 14px;font:400 16px/1.4 var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);letter-spacing:-0.01em;color:var(--ink,#0a0a0a);background:var(--field-bg,#fff);transition:border-color 0.15s,box-shadow 0.15s;}.ds-field::placeholder{color:var(--faint,#767676);}.ds-field:hover{border-color:#b5b5b5;}.ds-field:focus,.ds-field:focus-visible{outline:none;border-color:var(--primary,#14c4b4);box-shadow:0 0 0 4px var(--brand-ring,rgba(20,196,180,0.3));}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "sidebar-item",
      "description": "A tool group and its selected destination, using the existing navigation tokens.",
      "html": "<nav class=\"ds-sidebar\" aria-label=\"Herramientas\"><a class=\"ds-sidebar-row\" href=\"#inicio\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Inicio</a><a class=\"ds-sidebar-sub\" href=\"#matya\" aria-current=\"page\">Centro MATYA</a><a class=\"ds-sidebar-sub\" href=\"#herramientas\">Herramientas y diagnóstico</a></nav>",
      "css": ".ds-sidebar{display:flex;flex-direction:column;gap:2px;max-width:268px;font-family:var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);}.ds-sidebar-row,.ds-sidebar-sub{display:flex;align-items:center;gap:10px;border-radius:10px;color:var(--nav-ink,#333);text-decoration:none;font-size:14px;font-weight:400;line-height:1.25;letter-spacing:-0.01em;transition:background 0.15s,color 0.15s;}.ds-sidebar-row{min-height:38px;padding:0 10px 0 12px;}.ds-sidebar-sub{min-height:34px;padding:4px 12px;margin-left:14px;}.ds-sidebar-row:hover,.ds-sidebar-sub:hover{background:var(--nav-hover-bg,#f5f5f5);color:var(--nav-strong,#0a0a0a);}.ds-sidebar-sub[aria-current]{background:var(--nav-active-bg,#e3faf7);color:var(--nav-active-ink,#0b6e66);font-weight:600;}.ds-sidebar a:focus-visible{outline:2px solid var(--focus,#0b6e66);outline-offset:2px;}"
    },
