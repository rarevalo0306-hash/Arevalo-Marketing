      "html": "<span class=\"ds-status\">En cola</span><span class=\"ds-status ds-status-good\">Completado</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;font:600 12px/1.4 var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);border-radius:var(--pill,980px);padding:3px 10px;white-space:nowrap;background:var(--neutral-bg,#f2f2f2);color:var(--neutral-text,#5f5f5f);letter-spacing:0;}.ds-status::before{content:\"\";width:6px;height:6px;border-radius:3px;background:currentColor;opacity:0.8;}.ds-status-good{background:var(--ok-bg,#e5f6ea);color:var(--ok-text,#17702f);}"
    },
    {
      "name": "Shared card",
      "kind": "card",
      "refersTo": "card",
      "description": "The incumbent flat container for a related group of content.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">Resultados</h2><p class=\"ds-card-copy\">Consulta los resultados de tu negocio.</p><a class=\"ds-card-link\" href=\"#resultados\">Ver resultados</a></section>",
      "css": ".ds-card{background:var(--surface,#fff);border:1px solid var(--card-line,#e8e8e8);border-radius:var(--radius,20px);padding:28px;display:flex;flex-direction:column;gap:16px;box-shadow:var(--shadow,none);min-width:0;color:var(--ink,#0a0a0a);font-family:var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);}.ds-card-title{margin:0;font-family:var(--display,Figtree,ui-sans-serif,system-ui,sans-serif);font-size:var(--fs-card,19px);font-weight:700;line-height:1.25;letter-spacing:-0.02em;}.ds-card-copy{margin:0;font-size:16px;line-height:1.47;color:var(--muted,#666);}.ds-card-link{color:var(--link,#0b6e66);font-size:14px;text-decoration:none;}.ds-card-link:hover{text-decoration:underline;text-underline-offset:3px;}.ds-card-link:focus-visible{outline:2px solid var(--focus,#0b6e66);outline-offset:2px;}@media(max-width:640px){.ds-card{padding:20px;border-radius:18px;}}"
    },
    {
      "name": "MATYA section navigation",
      "kind": "nav",
      "refersTo": "matya-tabs",
      "description": "Horizontally scrollable section buttons with an explicit current section.",
      "html": "<nav class=\"ds-matya-tabs\" aria-label=\"Centro MATYA\"><button type=\"button\" aria-current=\"page\">Conversación</button><button type=\"button\">Conocimiento</button><button type=\"button\">Noticias</button><button type=\"button\">Resultados</button><button type=\"button\">Configuración</button></nav>",
      "css": ".ds-matya-tabs{display:flex;gap:24px;border-bottom:1px solid var(--line,#e8e8e8);overflow-x:auto;font-family:var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);}.ds-matya-tabs button{border:0;border-bottom:2px solid transparent;border-radius:0;background:none;color:var(--muted,#666);padding:13px 0;font:600 14px var(--body,Figtree,ui-sans-serif,system-ui,sans-serif);white-space:nowrap;cursor:pointer;min-height:44px;}.ds-matya-tabs button:hover{background:none;}.ds-matya-tabs button[aria-current]{color:var(--ink,#0a0a0a);border-bottom-color:var(--agent-accent,#087f75);}.ds-matya-tabs button:focus-visible{outline:2px solid var(--agent-accent,#087f75);outline-offset:4px;}@media(max-width:560px){.ds-matya-tabs{gap:22px;}.ds-matya-tabs button{font-size:13px;}}"
    },
