name: MATYA agent checks
on:
  pull_request:
    paths:
      - 'src/**'
      - 'tests/**'
      - 'prisma/**'
      - 'supabase/migrations/**'
      - 'package*.json'
      - '.github/workflows/matya-agent.yml'
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    services:
      postgres:
        image: postgres:17
        env:
          POSTGRES_PASSWORD: matya-local-test-only
          POSTGRES_DB: matya_agent
        ports:
          - 55439:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    env:
      DATABASE_URL: postgresql://postgres:matya-local-test-only@127.0.0.1:55439/matya_agent
      DIRECT_URL: postgresql://postgres:matya-local-test-only@127.0.0.1:55439/matya_agent
      MATYA_TEST_DATABASE_URL: postgresql://postgres:matya-local-test-only@127.0.0.1:55439/matya_agent
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci --no-audit --no-fund
      - name: Rehearse additive migration on the audited baseline
        run: |
          git show 9e191ac89d2120ee803b73aeccc9b7a162791b99:prisma/schema.prisma > /tmp/matya-base-schema.prisma
          npx prisma db push --schema /tmp/matya-base-schema.prisma --skip-generate
          psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -c 'CREATE ROLE anon; CREATE ROLE authenticated;'
          psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f supabase/migrations/20261012084743_matya_agent_workspace.sql
      - run: npm run build
      - run: npm run typecheck
      - run: npm test
