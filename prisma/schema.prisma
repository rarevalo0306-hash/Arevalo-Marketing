generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id          String       @id @default(cuid())
  name        String
  color       String       @default("#126BBC")
  website     String       @default("")
  /// Dueño o representante del negocio: a quién se le manda el reporte y con quién se habla.
  ownerName   String       @default("")
  ownerEmail  String       @default("")
  ownerPhone  String       @default("")
  /// Lo que la IA debe saber del negocio: servicios, zona, teléfono, tono, lo que nunca debe decir.
  aiProfile     String     @default("")
  /// Si es true, lo que planea la IA se programa solo; si es false, queda como borrador para aprobar.
  aiAutopublish Boolean    @default(false)
  /// IA para textos: gemini | claude | openai ("" = la primera disponible)
  aiText        String     @default("")
  /// IA para fotos: flux | openai | gemini ("" = la primera disponible)
  aiImage       String     @default("")
  /// Marca para los diseños: logo (URL pública, PNG), teléfono, y si se aplica sola a las fotos de la IA.
  logoUrl       String     @default("")
  phone         String     @default("")
  brandImages   Boolean    @default(true)
  /// Kit de marca: logo para fondos oscuros, colores secundario y de acento, letras, tono de voz y plantilla.
  logoLightUrl  String     @default("")
  color2        String     @default("")
  color3        String     @default("")
  fontHeading   String     @default("montserrat")
  fontBody      String     @default("")
  brandVoice    String     @default("")
  brandBookUrl  String     @default("")
  /// Imágenes de la marca: las que la IA sacó del manual (propuestas para aceptar o rechazar) y las que crea la app
  /// (foto de perfil, portadas, favicon, tarjeta…). Forma: BrandAssets en src/lib/brand-assets.ts.
  brandAssets   Json?
  hashtags      String     @default("")
  template      String     @default("auto")
  /// SEO con DataForSEO: zona de Google (código y nombre de DataForSEO), idioma de búsqueda,
  /// palabras clave que se siguen (lista de textos) y si se revisan las posiciones cada día.
  seoLocationCode Int?
  seoLocationName String   @default("")
  seoLanguage     String   @default("es")
  seoKeywords     Json?
  seoDaily        Boolean  @default(false)
  /// Cada cuántos días se revisan solas las posiciones cuando seoDaily está encendido: 1, 7, 15 o 30.
  seoRankDays     Int      @default(7)
  /// Zonas de Google elegidas (hasta 5): [{ code, name, type }]. La primera también queda en seoLocationCode/Name.
  seoLocations    Json?
  /// Avisos de SEO por email: a quién (hasta 3, separados por comas), avisos al bajar en la revisión diaria,
  /// resumen de cada lunes (y cuándo se mandó el último) e idioma de los emails ("es" | "en").
  seoAlertEmail   String   @default("")
  seoAlerts       Boolean  @default(false)
  seoWeekly       Boolean  @default(false)
  seoWeeklyAt     DateTime?
  seoEmailLang    String   @default("es")
  /// Reporte en PDF de cada mes (el día 1, del mes anterior) al mismo email de los avisos, y cuándo se mandó el último.
  seoMonthly      Boolean  @default(false)
  seoMonthlyAt    DateTime?
  /// El negocio en Google Maps, elegido por el dueño para el mapa de calor:
  /// { title, cid, placeId, featureId, address, lat, lng, domain, rating, reviews } (ver readMapPlace en src/lib/seo/maprank.ts).
  seoMapPlace     Json?
  /// Estudio del negocio hecho por la IA (StudySchema en src/lib/study-shape.ts), las respuestas del dueño y cuándo se hizo.
  study         Json?
  studyInput    Json?
  studyAt       DateTime?
  /// Carpeta de Google Drive con fotos y videos reales del negocio. La app la lee con su cuenta de servicio
  /// (el dueño comparte la carpeta con ese correo como Lector). Cuándo se revisó por última vez y el último error.
  driveFolderId   String   @default("")
  driveFolderName String   @default("")
  driveSyncedAt   DateTime?
  driveError      String   @default("")
  /// Link privado para que los técnicos suban fotos y videos sin entrar a la app (/subir/<token>). "" = sin link.
  uploadToken     String   @default("")
  createdAt   DateTime     @default(now())
  library     LibraryItem[]
  connections Connection[]
  contacts    Contact[]
  posts       Post[]
  templates   Template[]
  seoReports  SeoReport[]
}

/// Reportes de SEO de un negocio: auditoría del sitio, visibilidad en las IAs y Search Console.
/// `kind`: audit | ai | gsc. `data` tiene la forma que define cada módulo en src/lib/seo/.
model SeoReport {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String
  data       Json
  createdAt  DateTime @default(now())

  @@index([businessId, kind, createdAt])
}

/// Plantilla de diseño de un negocio (la crea la IA con su marca). `spec` sigue TemplateSpec (src/lib/design-shapes.ts).
model Template {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  spec       Json
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Credenciales de un canal para un negocio. `secret` va cifrado (AES-256-GCM).
model Connection {
  id         String   @id @default(cuid())
  businessId String
  channel    String
  label      String   @default("")
  secret     String
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel])
}

model Contact {
  id          String   @id @default(cuid())
  businessId  String
  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")
  emailOptIn  Boolean  @default(true)
  smsOptIn    Boolean  @default(false)
  /// Listas del contacto: "lead", "prospect", "client", "past-client"… (para mandar a cada grupo lo suyo).
  lists       String[] @default([])
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Post {
  id          String       @id @default(cuid())
  businessId  String
  text        String
  subject     String       @default("")
  seoTitle    String       @default("")
  mediaUrl    String       @default("")
  /// none | photo | video
  mediaType   String       @default("none")
  /// Texto distinto por canal: { "instagram": "...", "sms": "..." }. Si un canal no está, usa `text`.
  variants    Json?
  /// manual | ai
  source      String       @default("manual")
  /// draft | scheduled | publishing | done | partial | failed
  status      String       @default("scheduled")
  scheduledAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targets     PostTarget[]

  @@index([status, scheduledAt])
}

model PostTarget {
  id          String    @id @default(cuid())
  postId      String
  channel     String
  /// pending | sent | failed | skipped
  status      String    @default("pending")
  externalUrl String    @default("")
  detail      String    @default("")
  sentAt      DateTime?
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Fotos y videos reales del negocio (de su carpeta de Google Drive), con lo que la IA vio en cada uno.
/// Forma de `description` y listas de etiquetas/avisos: src/lib/library-shape.ts.
model LibraryItem {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// De dónde vino: drive | upload (link de subida, guardado en Cloudflare R2)
  source      String    @default("drive")
  /// Id del archivo en Google Drive, o la llave del archivo original en R2.
  externalId  String
  name        String    @default("")
  /// Carpeta dentro de la carpeta principal (ej. "Trabajos/Casa Pérez"), para dar contexto.
  folderPath  String    @default("")
  mimeType    String    @default("")
  /// photo | video
  kind        String    @default("photo")
  /// Copia en el almacenamiento de la app (las fotos al revisarlas; los videos cuando se usan).
  url         String    @default("")
  thumbUrl    String    @default("")
  width       Int       @default(0)
  height      Int       @default(0)
  durationSec Float     @default(0)
  sizeBytes   Int       @default(0)
  takenAt     DateTime?
  modifiedAt  DateTime?
  /// Lo que vio la IA (LibraryDescription).
  description Json?
  tags        String[]  @default([])
  /// 1 a 5 (0 = sin revisar)
  quality     Int       @default(0)
  usable      Boolean   @default(true)
  /// Avisos de privacidad: faces | address | plate | document | child
  privacy     String[]  @default([])
  /// new | ready | error | gone (ya no está en la carpeta)
  status      String    @default("new")
  error       String    @default("")
  /// Lo que decidió el dueño: "" (decide la IA) | "use" (aprobada aunque tenga avisos) | "skip" (no usar)
  choice      String    @default("")
  usedCount   Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([businessId, externalId])
  @@index([businessId, status])
}
