generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id          String       @id @default(cuid())
  name        String
  color       String       @default("#126BBC")
  website     String       @default("")
  /// Dueño o representante del negocio: a quién se le manda el reporte y con quién se habla.
  ownerName   String       @default("")
  ownerEmail  String       @default("")
  ownerPhone  String       @default("")
  /// Zona horaria del negocio (IANA, ej. "America/Managua"). "" = la de la app (BUSINESS_TZ). El reporte diario cierra a su medianoche.
  timezone    String       @default("")
  /// Reporte diario por email (cierra a la medianoche del negocio). A quién: reportEmail, o ownerEmail si está vacío.
  reportDaily Boolean      @default(true)
  reportEmail String       @default("")
  /// Lo que la IA debe saber del negocio: servicios, zona, teléfono, tono, lo que nunca debe decir.
  aiProfile     String     @default("")
  /// Si es true, lo que planea la IA se programa solo; si es false, queda como borrador para aprobar.
  aiAutopublish Boolean    @default(false)
  /// IA para textos: gemini | claude | openai ("" = la primera disponible)
  aiText        String     @default("")
  /// IA para fotos: flux | openai | gemini ("" = la primera disponible)
  aiImage       String     @default("")
  /// Marca para los diseños: logo (URL pública, PNG), teléfono, y si se aplica sola a las fotos de la IA.
  logoUrl       String     @default("")
  phone         String     @default("")
  brandImages   Boolean    @default(true)
  /// Kit de marca: logo para fondos oscuros, colores secundario y de acento, letras, tono de voz y plantilla.
  logoLightUrl  String     @default("")
  color2        String     @default("")
  color3        String     @default("")
  fontHeading   String     @default("montserrat")
  fontBody      String     @default("")
  brandVoice    String     @default("")
  brandBookUrl  String     @default("")
  /// Imágenes de la marca: las que la IA sacó del manual (propuestas para aceptar o rechazar) y las que crea la app
  /// (foto de perfil, portadas, favicon, tarjeta…). Forma: BrandAssets en src/lib/brand-assets.ts.
  brandAssets   Json?
  /// Identidad de la marca más allá de lo visual: eslogan, mensajes clave, voz (sí/no), música, y las propuestas
  /// de identidad de la IA para escoger. Forma: BrandIdentity en src/lib/brand-identity-shape.ts.
  brandIdentity Json?
  hashtags      String     @default("")
  template      String     @default("auto")
  /// SEO con DataForSEO: zona de Google (código y nombre de DataForSEO), idioma de búsqueda,
  /// palabras clave que se siguen (lista de textos) y si se revisan las posiciones cada día.
  seoLocationCode Int?
  seoLocationName String   @default("")
  seoLanguage     String   @default("es")
  seoKeywords     Json?
  seoDaily        Boolean  @default(false)
  /// Cada cuántos días se revisan solas las posiciones cuando seoDaily está encendido: 1, 7, 15 o 30.
  seoRankDays     Int      @default(7)
  /// Zonas de Google elegidas (hasta 5): [{ code, name, type }]. La primera también queda en seoLocationCode/Name.
  seoLocations    Json?
  /// Avisos de SEO por email: a quién (hasta 3, separados por comas), avisos al bajar en la revisión diaria,
  /// resumen de cada lunes (y cuándo se mandó el último) e idioma de los emails ("es" | "en").
  seoAlertEmail   String   @default("")
  seoAlerts       Boolean  @default(false)
  seoWeekly       Boolean  @default(false)
  seoWeeklyAt     DateTime?
  seoEmailLang    String   @default("es")
  /// Reporte en PDF de cada mes (el día 1, del mes anterior) al mismo email de los avisos, y cuándo se mandó el último.
  seoMonthly      Boolean  @default(false)
  seoMonthlyAt    DateTime?
  /// El negocio en Google Maps, elegido por el dueño para el mapa de calor:
  /// { title, cid, placeId, featureId, address, lat, lng, domain, rating, reviews } (ver readMapPlace en src/lib/seo/maprank.ts).
  seoMapPlace     Json?
  /// Estudio del negocio hecho por la IA (StudySchema en src/lib/study-shape.ts), las respuestas del dueño y cuándo se hizo.
  study         Json?
  studyInput    Json?
  studyAt       DateTime?
  /// Carpeta de Google Drive con fotos y videos reales del negocio. La app la lee con su cuenta de servicio
  /// (el dueño comparte la carpeta con ese correo como Lector). Cuándo se revisó por última vez y el último error.
  driveFolderId   String   @default("")
  driveFolderName String   @default("")
  driveSyncedAt   DateTime?
  driveError      String   @default("")
  /// Link privado para que los técnicos suban fotos y videos sin entrar a la app (/subir/<token>). "" = sin link.
  uploadToken     String   @default("")
  createdAt   DateTime     @default(now())
  library     LibraryItem[]
  tasks       ActionTask[]
  campaigns   Campaign[]
  aiActions   AiAction[]
  listings    DirectoryListing[]
  proposals   AiProposal[]
  connections Connection[]
  contacts    Contact[]
  posts       Post[]
  templates   Template[]
  seoReports  SeoReport[]
}

/// Reportes de SEO de un negocio: auditoría del sitio, visibilidad en las IAs y Search Console.
/// `kind`: audit | ai | gsc. `data` tiene la forma que define cada módulo en src/lib/seo/.
model SeoReport {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String
  data       Json
  createdAt  DateTime @default(now())

  @@index([businessId, kind, createdAt])
}

/// Plantilla de diseño de un negocio (la crea la IA con su marca). `spec` sigue TemplateSpec (src/lib/design-shapes.ts).
model Template {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  spec       Json
  createdAt  DateTime @default(now())

  @@index([businessId])
}

/// Credenciales de un canal para un negocio. `secret` va cifrado (AES-256-GCM).
model Connection {
  id         String   @id @default(cuid())
  businessId String
  channel    String
  label      String   @default("")
  secret     String
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, channel])
}

model Contact {
  id          String   @id @default(cuid())
  businessId  String
  name        String   @default("")
  email       String   @default("")
  phone       String   @default("")
  emailOptIn  Boolean  @default(true)
  smsOptIn    Boolean  @default(false)
  /// Listas del contacto: "lead", "prospect", "client", "past-client"… (para mandar a cada grupo lo suyo).
  lists       String[] @default([])
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Post {
  id          String       @id @default(cuid())
  businessId  String
  text        String
  subject     String       @default("")
  seoTitle    String       @default("")
  mediaUrl    String       @default("")
  /// none | photo | video
  mediaType   String       @default("none")
  /// Texto distinto por canal: { "instagram": "...", "sms": "..." }. Si un canal no está, usa `text`.
  variants    Json?
  /// manual | ai
  source      String       @default("manual")
  /// draft | scheduled | publishing | done | partial | failed
  status      String       @default("scheduled")
  scheduledAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  /// Qué es: post (una foto/diseño o solo texto) | carousel (varias fotos) | story (historia 9:16) | video
  kind        String       @default("post")
  /// Varias fotos (carrusel) o detalles de la foto: [{ url, alt, focus? {x,y} }]. Si falta, se usa mediaUrl.
  media       Json?
  /// Texto alternativo de la foto (con palabras clave) para Google, Facebook, LinkedIn y lectores de pantalla.
  altText     String       @default("")
  /// Campaña a la que pertenece (null = publicación suelta).
  campaignId  String?
  campaign    Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  targets     PostTarget[]

  @@index([status, scheduledAt])
  @@index([campaignId])
}

/// Campaña: un objetivo con fechas, canales y reglas. Tres modos: manual (el dueño hace todo), approval (la IA
/// propone y el dueño aprueba cada publicación) y auto (la IA publica sola dentro de los límites de `rules`).
/// Forma de `rules`: CampaignRules en src/lib/campaign-shape.ts.
model Campaign {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  /// Para qué es (en palabras del dueño): "más llamadas para reparación de portones"…
  goal        String     @default("")
  /// manual | approval | auto
  mode        String     @default("approval")
  /// draft | active | paused | stopped (parada de emergencia) | ended
  status      String     @default("draft")
  startsAt    DateTime   @default(now())
  endsAt      DateTime?
  channels    String[]   @default([])
  /// Publicaciones por semana (gratis).
  perWeek     Int        @default(3)
  keywords    String[]   @default([])
  /// Límites y reglas: temas prohibidos, máximo por día, horas sin publicar, avisos…
  rules       Json?
  /// Presupuesto de anuncios pagados en centavos de dólar (0 = solo gratis) y lo gastado.
  budgetCents Int        @default(0)
  spentCents  Int        @default(0)
  /// Anuncios creados en cada plataforma (ids externos, estado). Forma: src/lib/ads-shape.ts.
  ads         Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       Post[]
  actions     AiAction[]

  @@index([businessId, status])
}

/// Registro de lo que hizo la IA (sola o con aprobación): publicaciones, anuncios, pausas, paradas, fotos…
/// Sirve para el historial de cada campaña y para el reporte diario.
model AiAction {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  /// Qué hizo, con un punto: post.draft | post.scheduled | post.published | post.skipped | ad.created | ad.paused |
  /// campaign.started | campaign.paused | campaign.stopped | campaign.ended | limit.reached | alert.sent …
  kind       String
  /// { es, en }: una frase para el dueño.
  summary    Json
  detail     Json?
  /// auto (la IA sola) | approved (el dueño aprobó) | owner (lo hizo el dueño)
  actor      String    @default("auto")
  costCents  Int       @default(0)
  postId     String?
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([campaignId, createdAt])
}

/// El negocio en directorios (Google, Bing, Apple, Yelp, Facebook…): si está, si los datos coinciden y el link.
model DirectoryListing {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Clave del directorio (lista en src/lib/directories.ts).
  directory  String
  /// todo | listed | claimed | needs-fix | skip
  status     String    @default("todo")
  url        String    @default("")
  notes      String    @default("")
  /// Nombre, dirección y teléfono iguales a los del negocio (null = sin revisar).
  napOk      Boolean?
  checkedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, directory])
}

model PostTarget {
  id          String    @id @default(cuid())
  postId      String
  channel     String
  /// pending | sent | failed | skipped
  status      String    @default("pending")
  externalUrl String    @default("")
  detail      String    @default("")
  sentAt      DateTime?
  /// Id de la publicación en la red (para leer sus resultados: alcance, me gusta, comentarios…).
  externalId  String    @default("")
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  metrics     PostMetric[]

  @@index([postId])
}

/// Resultados de una publicación en una red, leídos cada cierto tiempo (el último es el actual).
model PostMetric {
  id           String     @id @default(cuid())
  postTargetId String
  target       PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)
  businessId   String
  channel      String
  fetchedAt    DateTime   @default(now())
  impressions  Int        @default(0)
  reach        Int        @default(0)
  likes        Int        @default(0)
  comments     Int        @default(0)
  shares       Int        @default(0)
  saves        Int        @default(0)
  clicks       Int        @default(0)
  videoViews   Int        @default(0)
  /// Lo que devolvió la red, por si sirve después.
  raw          Json?

  @@index([postTargetId, fetchedAt])
  @@index([businessId, fetchedAt])
}

/// Propuestas de la IA para mejorar (horarios, formatos, temas, presupuesto de anuncios, palabras clave…).
/// El dueño las acepta o las rechaza; las aceptadas se aplican (y quedan en el registro AiAction).
/// Forma de `action`: src/lib/proposals-shape.ts.
model AiProposal {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaignId String?
  /// timing | format | topic | channel | ads-budget | ads-pause | keyword | content | other
  kind       String
  /// { es, en }
  title      Json
  /// { es, en }: por qué (con los datos) y qué cambia
  detail     Json?
  /// 3 alto · 2 medio · 1 bajo
  impact     Int       @default(2)
  /// proposed | accepted | rejected | applied | expired
  status     String    @default("proposed")
  /// Qué cambio se aplica si se acepta (null = solo un consejo).
  action     Json?
  /// Datos en que se basa (para mostrar «por qué»).
  evidence   Json?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
  appliedAt  DateTime?

  @@index([businessId, status])
}

/// Fotos y videos reales del negocio (de su carpeta de Google Drive), con lo que la IA vio en cada uno.
/// Forma de `description` y listas de etiquetas/avisos: src/lib/library-shape.ts.
model LibraryItem {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// De dónde vino: drive | upload (link de subida, guardado en Cloudflare R2)
  source      String    @default("drive")
  /// Id del archivo en Google Drive, o la llave del archivo original en R2.
  externalId  String
  name        String    @default("")
  /// Carpeta dentro de la carpeta principal (ej. "Trabajos/Casa Pérez"), para dar contexto.
  folderPath  String    @default("")
  mimeType    String    @default("")
  /// photo | video
  kind        String    @default("photo")
  /// Copia en el almacenamiento de la app (las fotos al revisarlas; los videos cuando se usan).
  url         String    @default("")
  thumbUrl    String    @default("")
  width       Int       @default(0)
  height      Int       @default(0)
  durationSec Float     @default(0)
  sizeBytes   Int       @default(0)
  takenAt     DateTime?
  modifiedAt  DateTime?
  /// Lo que vio la IA (LibraryDescription).
  description Json?
  tags        String[]  @default([])
  /// 1 a 5 (0 = sin revisar)
  quality     Int       @default(0)
  usable      Boolean   @default(true)
  /// Avisos de privacidad: faces | address | plate | document | child
  privacy     String[]  @default([])
  /// new | ready | error | gone (ya no está en la carpeta)
  status      String    @default("new")
  error       String    @default("")
  /// Lo que decidió el dueño: "" (decide la IA) | "use" (aprobada aunque tenga avisos) | "skip" (no usar)
  choice      String    @default("")
  /// Versión mejorada por la app (luz, color, nitidez, enderezada, datos privados tapados). La original (`url`)
  /// nunca se toca. Forma de `enhanceInfo`: EnhanceInfo en src/lib/photo-enhance-shape.ts.
  enhancedUrl String    @default("")
  enhanceInfo Json?
  enhancedAt  DateTime?
  /// Si las publicaciones usan la mejorada (true) o la original (false).
  useEnhanced Boolean   @default(true)
  usedCount   Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([businessId, externalId])
  @@index([businessId, status])
}

/// Plan de acción único: cada problema u oportunidad encontrada en el diagnóstico (auditoría, páginas, palabras,
/// enlaces, Maps, reseñas, IAs…) como una tarea en palabras simples. `key` es estable para no duplicar al volver a
/// armar el plan; lo que ya no aparece queda "gone". Forma de los textos: src/lib/action-plan-shape.ts.
model ActionTask {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String
  /// De qué reporte salió: audit | onpage | keywords | content | links | local | reviews | ai | schema | gsc | setup
  source     String
  /// Para agrupar: web | google | maps | ia | contenido | enlaces | marca
  area       String
  /// { es, en }
  title      Json
  /// { es, en }: por qué importa y cómo se arregla
  detail     Json?
  /// 3 alto · 2 medio · 1 bajo
  impact     Int       @default(2)
  /// 1 fácil · 2 medio · 3 difícil
  effort     Int       @default(2)
  /// Dónde se ve o se arregla dentro de la app (/b/<id>/...)
  href       String    @default("")
  /// todo | done | dismissed | gone
  status     String    @default("todo")
  doneAt     DateTime?
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@unique([businessId, key])
  @@index([businessId, status])
}
